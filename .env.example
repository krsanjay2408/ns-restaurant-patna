# NS Restaurant Patna - Environment Variables Template
# =======================================================
# CRITICAL SECURITY NOTE:
# This file (.env.example) is just a public template.
# DO NOT put real secret keys here!
#
# To use real keys locally:
# 1. Create a file named ".env" in this project folder.
# 2. Copy the keys below into ".env" and fill in your actual credentials.
# 3. ".env" is protected by .gitignore and will NEVER be committed to GitHub.

# --- Optional: Google OAuth Client ID ---
# (From Google Cloud Console: https://console.cloud.google.com/apis/credentials)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# --- Optional: Firebase Auth (for Real SMS Phone OTP) ---
# (From Firebase Console: https://console.firebase.google.com)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=ns-restaurant-patna.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ns-restaurant-patna
VITE_FIREBASE_STORAGE_BUCKET=ns-restaurant-patna.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# --- Optional: WhatsApp Business / Order Webhook URL ---
# (Your WhatsApp Cloud API or Twilio WhatsApp endpoint)
VITE_WHATSAPP_BOT_NUMBER=+919431099887
VITE_RESTAURANT_NOTIFICATION_WHATSAPP=919431099887
